META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1/
META_MODEL=

# CDISC Library subscription key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
CDISC_LIBRARY_API_KEY=
CDISC_LIBRARY_BASE_URL=https://library.cdisc.org/api
CDISC_LIBRARY_TIMEOUT_SECONDS=30
CDISC_LIBRARY_COSMOS_VERSION=v2
CDISC_MCP_TRANSPORT=stdio
CDISC_MCP_HOST=127.0.0.1
CDISC_MCP_PORT=8001

# Workbench MCP adapter. Docker Compose overrides the API URL to use the api service name.
WORKBENCH_API_URL=http://127.0.0.1:8000/api/v1
WORKBENCH_API_TIMEOUT_SECONDS=60
WORKBENCH_MCP_TRANSPORT=stdio
WORKBENCH_MCP_HOST=127.0.0.1
WORKBENCH_MCP_PORT=8002

FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=backend/data
MAX_FILE_MB=25
MAX_PDF_PAGES=200
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
