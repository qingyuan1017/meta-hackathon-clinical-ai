META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
MAX_AUDIO_MB=16
TRANSCRIPTION_TIMEOUT_SECONDS=300
AGENT_MAX_TURNS=20
AGENT_MAX_REMOTE_TOOL_CALLS=6

# CDISC Library subscription key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
CDISC_LIBRARY_API_KEY=
CDISC_LIBRARY_BASE_URL=https://library.cdisc.org/api
CDISC_LIBRARY_TIMEOUT_SECONDS=30
CDISC_LIBRARY_COSMOS_VERSION=v2
CDISC_MCP_TRANSPORT=stdio
CDISC_MCP_HOST=127.0.0.1
CDISC_MCP_PORT=8001
CDISC_MCP_ENABLED=true
CDISC_MCP_URL=http://127.0.0.1:8001/mcp

# Public ClinicalTrials.gov service and backend MCP connection (no API key required).
CLINICALGOV_API_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALGOV_API_TIMEOUT_SECONDS=30
CLINICALGOV_MCP_TRANSPORT=stdio
CLINICALGOV_MCP_HOST=127.0.0.1
CLINICALGOV_MCP_PORT=8003
CLINICALGOV_MCP_ENABLED=true
CLINICALGOV_MCP_URL=http://127.0.0.1:8003/mcp
CLINICALGOV_MAX_TOOL_ROUNDS=3

# Public openFDA service and backend MCP connection. A free API key is recommended.
OPENFDA_API_KEY=
OPENFDA_TIMEOUT_SECONDS=30
OPENFDA_MAX_RESULTS=100
OPENFDA_MAX_RETRIES=2
OPENFDA_MCP_PORT=8765
OPENFDA_MCP_ENABLED=true
OPENFDA_MCP_URL=http://127.0.0.1:8765/mcp
OPENFDA_MAX_TOOL_ROUNDS=3

# NCBO BioPortal service and backend MCP connection. Create a key at bioportal.bioontology.org.
BIOPORTAL_API_KEY=
BIOPORTAL_API_BASE_URL=https://data.bioontology.org
BIOPORTAL_API_TIMEOUT_SECONDS=30
BIOPORTAL_MCP_TRANSPORT=stdio
BIOPORTAL_MCP_HOST=127.0.0.1
BIOPORTAL_MCP_PORT=8004
BIOPORTAL_MCP_ENABLED=true
BIOPORTAL_MCP_URL=http://127.0.0.1:8004/mcp
BIOPORTAL_MAX_TOOL_ROUNDS=3

# PubMed via NCBI E-utilities. A real contact email is required by NCBI; the API key is optional.
PUBMED_EMAIL=
PUBMED_API_KEY=
PUBMED_TOOL=clinical_ai_pubmed_mcp
PUBMED_API_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_TIMEOUT_SECONDS=30
PUBMED_MAX_RESULTS=20
PUBMED_MCP_TRANSPORT=stdio
PUBMED_MCP_HOST=127.0.0.1
PUBMED_MCP_PORT=8005
PUBMED_MCP_ENABLED=true
PUBMED_MCP_URL=http://127.0.0.1:8005/mcp
PUBMED_MAX_TOOL_ROUNDS=3

# Workbench MCP adapter. Docker Compose overrides the API URL to use the api service name.
WORKBENCH_API_URL=http://127.0.0.1:8000/api/v1
WORKBENCH_API_TIMEOUT_SECONDS=60
WORKBENCH_MCP_TRANSPORT=stdio
WORKBENCH_MCP_HOST=127.0.0.1
WORKBENCH_MCP_PORT=8002

FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=backend/data
MAX_FILE_MB=25
MAX_PDF_PAGES=200
CORE_CLI_PATH=/opt/cdisc-core/core.py
CORE_TIMEOUT_SECONDS=600
CORE_POOL_SIZE=2
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
